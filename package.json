{
  "name": "vyapaarflow-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js",
    "dev:all": "node start.js",
    "build:shared": "npm run --workspace=shared build",
    "dev:backend": "npm run --workspace=backend dev",
    "dev:frontend": "npm run --workspace=frontend dev",
    "build": "npm run --workspace=shared build && npm run --workspace=backend build && npm run --workspace=frontend build",
    "test:backend": "npm run --workspace=backend test",
    "seed": "npm run --workspace=backend seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
