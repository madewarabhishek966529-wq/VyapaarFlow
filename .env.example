PORT=5000
NODE_ENV=development

# Database Connection (Leave empty or default for zero-config automatic in-memory MongoDB)
MONGODB_URI=mongodb://localhost:27017/vyapaarflow

# Authentication & Security Secrets
JWT_SECRET=vyapaarflow_super_secret_jwt_key_2026_replace_in_production
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=vyapaarflow_super_refresh_jwt_key_2026_replace_in_production
REFRESH_TOKEN_EXPIRES_IN=30d

# Frontend & CORS Origin
FRONTEND_URL=http://localhost:3000

# Razorpay Payment Gateway (Optional for live subscription checkout)
RAZORPAY_KEY_ID=rzp_test_sample_key
RAZORPAY_KEY_SECRET=sample_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret
